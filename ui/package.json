{
  "name": "meada-ui",
  "private": true,
  "type": "module",
  "engines": { "node": "22.23.1" },
  "scripts": {
    "wasm": "node scripts/wasm.mjs",
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && node scripts/version.mjs",
    "check:version": "node scripts/version.mjs --check",
    "test": "vitest run"
  },
  "dependencies": { "react": "19.3.1", "react-dom": "19.3.1" },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
