<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <AssemblyName>Example.$(MSBuildProjectName)</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Example.Shared" />
    <PackageReference Include="Example.Analyzers" Version="1.0" PrivateAssets="all" />
    <ProjectReference Include="..\Core\Core.csproj" />
  </ItemGroup>

</Project>
