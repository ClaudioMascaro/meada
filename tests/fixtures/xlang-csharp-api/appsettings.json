{
  // .NET reads comments and trailing commas in its configuration files.
  "Logging": { "LogLevel": { "Default": "Information", }, },
  /* No host a peer serves: the key maps to the variable Prices__BaseUrl. */
  "Prices": { "BaseUrl": "http://localhost:3000", },
  /* A host the web app serves, under a key written in another case than the code reads it. */
  "audit": { "URL": "https://web.example.com/api/" },
}
