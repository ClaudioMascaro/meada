  "revocation": [
    {
      "name": "the creator loses A: it keeps the workspace and a hidden count",
      "revoke": { "caller": "alice", "identity": "A" },
      "workspace": "w_ya",
      "expect": [
        { "caller": "alice", "visible": true, "readable": ["Y"], "hidden": 1, "may_add": ["Y"], "may_remove": ["Y"] },
        { "caller": "erin", "visible": true, "readable": ["Y", "A"], "hidden": 0 }
      ]
    },
    {
      "name": "a group peer loses A: the workspace is hidden from it, the creator is untouched",
      "revoke": { "caller": "erin", "identity": "A" },
      "workspace": "w_ya",
      "expect": [
        { "caller": "erin", "visible": false },
        { "caller": "alice", "visible": true, "readable": ["Y", "A"], "hidden": 0 }
      ]
    },
    {
      "name": "the group role on Y is revoked for the peer: hidden as well",
      "revoke": { "caller": "erin", "identity": "Y" },
      "workspace": "w_ya",
      "expect": [
        { "caller": "erin", "visible": false },
        { "caller": "alice", "visible": true, "readable": ["Y", "A"], "hidden": 0 }
      ]
    }
  ],
  "sponsor": [
    {
      "name": "an entry no operator holds a role on is excluded before the fetch",
      "workspace": "w_ya",
      "revoke": { "caller": "alice", "identity": "A" },
      "excluded": ["A"]
    },
    {
      "name": "a role held by a second operator keeps the entry",
      "workspace": "w_ya",
      "operators": ["alice", "dave"],
      "revoke": { "caller": "alice", "identity": "A" },
      "excluded": []
    }
  ],
  "membership": {
    "about": "One entry per identity across the deployment workspace and every named workspace.",
    "named": ["w_ya", "w_yb", "w_yab"],
    "members": ["A", "B", "Y"],
    "bundles": { "Y": 1, "A": 1, "B": 1 }
  },
  "lifecycle": [
    {
      "name": "the creator edits the entries it reads: nothing changes for a plain resave",
      "caller": "alice",
      "workspace": "w_ya",
      "submit": ["Y", "A"],
      "stored": ["Y", "A"],
      "rechecked": [],
      "allowed": true
    },
    {
      "name": "the creator cannot add B: Y and A are its grants only",
      "caller": "alice",
      "workspace": "w_ya",
      "submit": ["Y", "A", "B"],
      "stored": ["Y", "A", "B"],
      "rechecked": ["B"],
      "allowed": false,
      "hidden": 1
    },
    {
      "name": "after losing A the creator saves what it reads and A stays in place",
      "caller": "alice",
      "workspace": "w_ya",
      "revoke": { "caller": "alice", "identity": "A" },
      "submit": ["Y"],
      "stored": ["Y", "A"],
      "rechecked": [],
      "allowed": true
    },
    {
      "name": "after losing A the creator cannot overwrite A by naming it",
      "caller": "alice",
      "workspace": "w_ya",
      "revoke": { "caller": "alice", "identity": "A" },
      "submit": ["Y", "A"],
      "stored": ["Y", "A"],
      "rechecked": [],
      "allowed": true
    },
    {
      "name": "after losing Y the creator cannot re-add or change Y, which it no longer reads",
      "caller": "alice",
      "workspace": "w_ya",
      "revoke": { "caller": "alice", "identity": "Y" },
      "submit": ["A"],
      "stored": ["Y", "A"],
      "rechecked": [],
      "allowed": true
    },
    {
      "name": "the platform administrator adds B to a workspace it does not operate by creation",
      "caller": "root",
      "workspace": "w_ya",
      "submit": ["Y", "A", "B"],
      "stored": ["Y", "A", "B"],
      "rechecked": ["B"],
      "allowed": true
    },
    {
      "name": "bob shares Y with alice's workspace but cannot extend it with his B: he operates nothing there",
      "caller": "bob",
      "workspace": "w_ya",
      "submit": ["Y", "A", "B"],
      "operates": false
    }
  ]
