{
  "about": "The Y/A/B matrix of ADR 0020 and the contracts of ADR 0021, as data. Y grants an accepted role to groups A and B, repository A to group A only, repository B to group B only. Rows are the effective per-login rows of the permissions set (via is provenance and decides nothing). meada-core/tests/named_workspaces.rs checks the rows against the rules of the ADRs; the runtime tickets (#341 to #346) read the same rows in their Rust, public-process and WebAssembly tests and add rows, never rewrite one without an ADR amendment.",
  "identities": {
    "Y": "github.com/acme/y",
    "A": "github.com/acme/a",
    "B": "github.com/acme/b"
  },
  "accepted_roles": ["write", "maintain", "admin"],
  "callers": {
    "alice": {
      "login": "alice",
      "rows": [
        { "identity": "Y", "role": "write", "via": "group:ab" },
        { "identity": "A", "role": "write", "via": "group:a" }
      ]
    },
    "dave": {
      "login": "dave",
      "rows": [
        { "identity": "Y", "role": "write", "via": "direct" },
        { "identity": "A", "role": "write", "via": "direct" }
      ]
    },
    "erin": {
      "login": "erin",
      "rows": [
        { "identity": "Y", "role": "maintain", "via": "group:ab" },
        { "identity": "A", "role": "maintain", "via": "group:a" }
      ]
    },
    "bob": {
      "login": "bob",
      "rows": [
        { "identity": "Y", "role": "write", "via": "group:ab" },
        { "identity": "B", "role": "write", "via": "group:b" }
      ]
    },
    "carol": {
      "login": "carol",
      "rows": [
        { "identity": "Y", "role": "write", "via": "group:ab" },
        { "identity": "A", "role": "write", "via": "group:a" },
        { "identity": "B", "role": "write", "via": "group:b" }
      ]
    },
    "yoda": {
      "login": "yoda",
      "rows": [{ "identity": "Y", "role": "write", "via": "group:ab" }]
    },
    "zed": {
      "login": "zed",
      "rows": [
        { "identity": "Y", "role": "read", "via": "group:ab" },
        { "identity": "A", "role": "read", "via": "group:a" }
      ]
    },
    "claims": {
      "login": "claims",
      "rows": [],
      "claims_grant": ["Y", "A"]
    },
    "nologin": {
      "login": null,
      "rows": [],
      "claims_grant": []
    },
    "root": {
      "login": "root",
      "rows": [],
      "platform_administrator": true
    }
  },
  "workspaces": {
    "w_ya": { "entries": ["Y", "A"], "operators": ["alice"] },
    "w_yb": { "entries": ["Y", "B"], "operators": ["bob"] },
    "w_yab": { "entries": ["Y", "A", "B"], "operators": ["carol"] },
    "w_y": { "entries": ["Y"], "operators": ["yoda"] }
  },
