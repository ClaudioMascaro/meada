{
  "apiVersion": "monitoring.coreos.com/v1",
  "kind": "PrometheusRule",
  "metadata": {
    "name": "ledger-signals",
    "labels": {
      "support": "json-metadata-ghost"
    }
  },
  "spec": {
    "groups": [
      {
        "name": "ledger-checks",
        "labels": {
          "support": "ledger",
          "service": "ledger-api",
          "severity": "critical",
          "team": "ledger"
        },
        "rules": [
          {
            "alert": "LedgerWarn",
            "expr": "vector(1)",
            "labels": {
              "severity": "warn"
            },
            "annotations": {
              "support": "json-annotation-ghost"
            }
          }
        ]
      }
    ]
  }
}
