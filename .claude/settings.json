{
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "enabledPlugins": {
    "mattpocock-skills@claude-plugins-official": false,
    "ponytail@ponytail": true,
    "ray-amjad-skills@ray-amjad": false
  },
  "enabledMcpjsonServers": [
    "meada"
  ],
  "permissions": {
    "allow": [
      "mcp__meada"
    ]
  },
  "skillOverrides": {
    "git-guardrails-claude-code": "off",
    "migrate-to-shoehorn": "off",
    "scaffold-exercises": "off",
    "setup-pre-commit": "off"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/cloud-git-check-off.sh"
          },
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/ponytail-cloud.sh ponytail-activate.js",
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/ponytail-cloud.sh ponytail-subagent.js",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/ponytail-cloud.sh ponytail-mode-tracker.js",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/prove-stop.sh",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
