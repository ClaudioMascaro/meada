# The local accounts proof of concept (ADR 0024): cp .env.accounts.example .env, fill it in and run
# `docker compose up -d`. COMPOSE_FILE and COMPOSE_PROFILES select the whole recipe.
COMPOSE_FILE=compose.yaml:compose.console.yaml:compose.postgres.yaml:compose.accounts.yaml
COMPOSE_PROFILES=generations,console
MEADA_VERSION=1.1.0
MEADA_PORT=8443
# compose.yaml asks for MEADA_TOKEN at interpolation; this profile's proxy neither receives nor checks it.
MEADA_TOKEN=unused
REPOSITORIES=https://github.com/claudiomascaro/meada.git
REFRESH_SECONDS=300
VALKEY_PASSWORD=replace-with-a-random-password
AWS_ACCESS_KEY_ID=meada-compose
AWS_SECRET_ACCESS_KEY=replace-with-a-random-secret
# Use letters and digits only: the passwords sit in connection URLs.
POSTGRES_PASSWORD=replace-with-a-random-password
POSTGRES_MIGRATE_PASSWORD=replace-with-a-random-password
POSTGRES_WRITE_PASSWORD=replace-with-a-random-password
POSTGRES_READ_PASSWORD=replace-with-a-random-password
# The default account's initial password. Empty: generated, printed once in the console's log
# (`docker compose logs console | grep 'first password'`), changed at the first sign-in.
# Set (12 to 128 characters, not a common password): that is its password, with no change forced.
MEADA_ADMIN_PASSWORD=
