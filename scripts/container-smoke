#!/usr/bin/env python3
"""Check an OCI image through its CLI and a search over its published HTTP port."""

import argparse
import json
import os
from pathlib import Path
import subprocess
import tarfile
import tempfile
import time
import tomllib
import urllib.error
import urllib.request


def run(*args, **kwargs):
    result = subprocess.run(args, text=True, capture_output=True, **kwargs)
    if result.returncode:
        print(result.stderr, end="")
    result.check_returncode()
    return result.stdout


parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("image")
parser.add_argument("--cloud", action="store_true")
parser.add_argument("--ui-tarball", type=Path)
args = parser.parse_args()
if args.ui_tarball and not args.cloud:
    parser.error("--ui-tarball requires --cloud")
image = args.image
root = Path(__file__).resolve().parent.parent
version = tomllib.loads((root / "Cargo.toml").read_text())["workspace"]["package"]["version"]
assert run("docker", "run", "--rm", image, "--version").strip() == f"meada {version}"
config = json.loads(run("docker", "image", "inspect", image))[0]["Config"]
assert config["Entrypoint"] == ["meada"] and not config.get("Cmd"), config
assert config["User"] and config["User"] not in ("root", "0"), config["User"]
assert config["Labels"]["org.opencontainers.image.source"] == "https://github.com/ClaudioMascaro/meada"
assert config["Labels"]["org.opencontainers.image.version"] == version
assert config["Labels"]["org.opencontainers.image.licenses"] == "Apache-2.0"
runtime = run("docker", "run", "--rm", "--entrypoint", "sh", image, "-ec",
              'test "$(id -u)" != 0; test -d "$HOME"; test -w "$HOME"; '
              'test -s /etc/ssl/certs/ca-certificates.crt; git --version')
git_version = tuple(map(int, runtime.strip().split()[-1].split(".")[:2]))
assert git_version >= (2, 38), runtime
snapshot = subprocess.run(["docker", "run", "--rm", image, "snapshot", "--help"],
                          text=True, capture_output=True)
assert (snapshot.returncode == 0) == args.cloud, snapshot
if not args.cloud:
    assert snapshot.returncode == 2 and "snapshot" in snapshot.stderr, snapshot
ui = subprocess.run(["docker", "run", "--rm", image, "ui", "--help"],
                    text=True, capture_output=True)
assert (ui.returncode == 0) == args.cloud, ui
if not args.cloud:
    assert ui.returncode == 2 and "ui" in ui.stderr, ui
frontend = subprocess.run(["docker", "run", "--rm", "--entrypoint", "test", image,
                           "-d", "/usr/share/meada/ui"], capture_output=True)
assert (frontend.returncode == 0) == args.cloud, "only the cloud image carries the frontend"

with tempfile.TemporaryDirectory(prefix="meada-container-") as name:
    data = Path(name)
    data.chmod(0o755)
    mirror = data / "mirror"
    mirror.mkdir()
    (mirror / "lib.rs").write_text("pub fn container_search_marker() {}\n")
    run("git", "init", "--initial-branch", "main", str(mirror))
    run("git", "-C", str(mirror), "remote", "add", "origin",
        "https://example.com/container/smoke.git")
    run("git", "-C", str(mirror), "add", ".")
    run("git", "-C", str(mirror), "-c", "user.name=Container smoke",
        "-c", "user.email=smoke@example.com", "commit", "-m", "fixture")
    indexes = data / "indexes"
    indexes.mkdir()
    manifest = data / "meada.workspace.toml"
    manifest.write_text('index_dir = "/var/lib/meada"\n\n[[repository]]\n'
                        'repo = "example.com/container/smoke"\npath = "/srv/mirrors/smoke"\n')
    mounts = ["--mount", f"type=bind,src={mirror},dst=/srv/mirrors/smoke,readonly",
              "--mount", f"type=bind,src={manifest},dst=/etc/meada/meada.workspace.toml,readonly"]
    workspace = ["--workspace", "/etc/meada/meada.workspace.toml"]
    run("docker", "run", "--rm", "--network", "none",
        "--user", f"{os.getuid()}:{os.getgid()}", *mounts,
        "--mount", f"type=bind,src={indexes},dst=/var/lib/meada", image, "index", *workspace)
    container = run("docker", "run", "--detach", "--read-only", *mounts,
                    "--mount", f"type=bind,src={indexes},dst=/var/lib/meada,readonly",
                    "--publish", "127.0.0.1::7333", image,
                    "mcp", "--listen", "0.0.0.0:7333", *workspace).strip()
    try:
        port = run("docker", "port", container, "7333/tcp").strip().rsplit(":", 1)[1]
        url = f"http://127.0.0.1:{port}/example.com/container/smoke"
        body = json.dumps({"jsonrpc": "2.0", "id": 1, "method": "tools/call", "params": {
            "name": "search", "arguments": {"query": "container_search_marker"}}}).encode()
        request = urllib.request.Request(url, data=body, headers={
            "Content-Type": "application/json", "Accept": "application/json, text/event-stream",
            "MCP-Protocol-Version": "2025-06-18"})
        client = urllib.request.build_opener(urllib.request.ProxyHandler({}))
        deadline = time.monotonic() + 30
        while True:
            try:
                with client.open(request, timeout=2) as response:
                    answer = json.load(response)
                break
            except urllib.error.HTTPError as error:
                raise RuntimeError(error.read().decode()) from error
            except (urllib.error.URLError, TimeoutError):
                if time.monotonic() >= deadline:
                    raise
                time.sleep(0.1)
        assert "error" not in answer and not answer["result"].get("isError"), answer
        assert any("container_search_marker" in content.get("text", "")
                   for content in answer["result"]["content"]), answer
        print(f"{image}: non-root CLI, git, CA roots and HTTP search passed")
    finally:
        subprocess.run(["docker", "logs", container], check=False)
        run("docker", "rm", "--force", container)

    if args.cloud:
        public_url = "http://127.0.0.1:7334"
        manifest.write_text(manifest.read_text() + '\n[ui]\ndir = "/usr/share/meada/ui"\n'
                            f'public_url = "{public_url}"\n')
        container = run("docker", "run", "--detach", "--read-only", *mounts,
                        "--mount", f"type=bind,src={indexes},dst=/var/lib/meada,readonly",
                        "--publish", "127.0.0.1::7334", image,
                        "ui", "--listen", "0.0.0.0:7334", *workspace).strip()
        try:
            port = run("docker", "port", container, "7334/tcp").strip().rsplit(":", 1)[1]
            deadline = time.monotonic() + 30

            def get(path):
                request = urllib.request.Request(f"http://127.0.0.1:{port}{path}",
                                                 headers={"Host": "127.0.0.1:7334"})
                while True:
                    try:
                        with client.open(request, timeout=2) as response:
                            return response.read()
                    except urllib.error.HTTPError as error:
                        raise RuntimeError(error.read().decode()) from error
                    except (urllib.error.URLError, TimeoutError):
                        if time.monotonic() >= deadline:
                            raise
                        time.sleep(0.1)

            frontend = data / "ui"
            run("docker", "cp", f"{container}:/usr/share/meada/ui", str(frontend))
            assert get("/") == (frontend / "index.html").read_bytes()
            assert json.loads(get("/meada-ui.json")) == {"version": version}
            configuration = json.loads(get("/api/v1/config"))
            assert configuration["version"] == version, configuration
            assert configuration["public_url"] == public_url, configuration
            if args.ui_tarball:
                prefix = f"meada-ui-{version}/"
                expected = {path.relative_to(frontend).as_posix(): path.read_bytes()
                            for path in frontend.rglob("*") if path.is_file()}
                with tarfile.open(args.ui_tarball, "r:gz") as archive:
                    members = archive.getmembers()
                    assert all(member.name == prefix[:-1] or member.name.startswith(prefix)
                               for member in members), "one versioned directory required"
                    assert all(member.isdir() or member.isfile() for member in members)
                    actual = {member.name[len(prefix):]: archive.extractfile(member).read()
                              for member in members if member.isfile()}
                assert sorted(actual) == sorted(expected), "archive and image file lists differ"
                assert actual == expected, "archive and image file contents differ"
            print(f"{image}: console HTTP, version and frontend files passed")
        finally:
            subprocess.run(["docker", "logs", container], check=False)
            run("docker", "rm", "--force", container)
