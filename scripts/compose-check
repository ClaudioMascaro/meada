#!/usr/bin/env python3
"""Validate Compose profiles without starting services or printing credentials."""

import json
import pathlib
import subprocess
import tomllib

ROOT = pathlib.Path(__file__).resolve().parents[1]
DEPLOY = ROOT / "deploy/compose"


def render(profile, console=False):
    command = ["docker", "compose", "--env-file", ".env.example", "-f", "compose.yaml"]
    if console:
        command += ["-f", "compose.console.yaml", "--profile", "console"]
    command += ["--profile", profile, "config", "--format", "json"]
    return json.loads(subprocess.check_output(command, cwd=DEPLOY, text=True))


local = render("local")
generations = render("generations")
for profile in [local, generations]:
    assert not any("console" in name for name in profile["services"])
console = render("generations", console=True)["services"]
assert console["console"]["command"][:2] == ["ui", "--listen"]
print("compose-check: local, generations and console profiles passed")

for name in ["console", "console-first-pull", "console-pull"]:
    service = console[name]
    assert service["image"].endswith("-cloud")
    data = next(mount for mount in service["volumes"] if mount["target"] == "/var/lib/meada/console")
    assert data["source"] == "console-data"
    assert all(mount.get("source") not in {"node-one", "node-two", "job-indexes"} for mount in service["volumes"])
assert console["console"]["depends_on"]["console-first-pull"]["condition"] == "service_completed_successfully"
assert console["console-pull"]["command"][:4] == ["snapshot", "pull", "--every", "30"]
assert console["console-proxy"]["ports"][0]["host_ip"] == "127.0.0.1"
assert "environment" not in console["console-proxy"]
assert all("ports" not in console[name] for name in ["console", "console-pull", "console-first-pull"])
writer = console["generation-indexer"]
mounts = {mount["target"]: pathlib.Path(mount["source"]).name for mount in writer["volumes"] if mount["type"] == "bind"}
assert mounts["/etc/meada/meada.workspace.toml"] == "job.workspace.toml"
assert mounts["/etc/meada/refresh.sh"] == "managed-refresh.sh"
node_bootstrap = tomllib.loads((DEPLOY / "generations.workspace.toml").read_text())
console_bootstrap = tomllib.loads((DEPLOY / "console.workspace.toml").read_text())
job_bootstrap = tomllib.loads((DEPLOY / "job.workspace.toml").read_text())
for bootstrap in [console_bootstrap, job_bootstrap]:
    assert bootstrap["workspace"]["source"] == "store" and "repository" not in bootstrap
    for section in ["valkey", "generations", "refresh_lock"]:
        assert bootstrap[section] == node_bootstrap[section]
    for key in ["endpoint", "region", "bucket", "prefix", "credentials", "ca_file"]:
        assert bootstrap["snapshot"][key] == node_bootstrap["snapshot"][key]
assert console_bootstrap["snapshot"]["local_dir"] != node_bootstrap["snapshot"]["local_dir"]
assert console_bootstrap["ui"]["public_url"] == "https://localhost:8444"
assert not console_bootstrap["ui"]["operations"]
assert console_bootstrap["ui"]["dir"] == "/usr/share/meada/ui"
seed = tomllib.loads((DEPLOY / "console.repositories.toml").read_text())
assert seed["repository"] == node_bootstrap["repository"]
print("compose-check: isolated storage, managed writer and public console proxy contracts passed")

postgres = json.loads(subprocess.check_output(
    ["docker", "compose", "--env-file", ".env.example", "-f", "compose.yaml", "-f", "compose.console.yaml",
     "-f", "compose.postgres.yaml", "--profile", "generations", "--profile", "console", "config", "--format", "json"],
    cwd=DEPLOY, text=True))["services"]
assert "postgres" not in console and "postgres-migrate" not in console, "Postgres is opt-in"
assert postgres["postgres"]["image"].startswith("postgres:15")
assert "ports" not in postgres["postgres"]
assert postgres["postgres-migrate"]["command"][:2] == ["postgres", "migrate"]
assert postgres["postgres-migrate"]["depends_on"]["postgres"]["condition"] == "service_healthy"
for name in ["generation-indexer", "console", "generation-one", "generation-two"]:
    assert postgres[name]["depends_on"]["postgres-migrate"]["condition"] == "service_completed_successfully", name
assert postgres["generation-one"]["environment"]["MEADA_POSTGRES_READ_URL"].startswith("postgres://meada_read:")
assert postgres["console"]["environment"]["MEADA_POSTGRES_URL"].startswith("postgres://meada_write:")
assert postgres["postgres-migrate"]["environment"]["MEADA_POSTGRES_MIGRATE_URL"].startswith("postgres://meada_migrate:")
migrate = tomllib.loads((DEPLOY / "postgres.workspace.toml").read_text())
assert list(migrate) == ["postgres"] and migrate["postgres"]["url_env"] == "MEADA_POSTGRES_MIGRATE_URL"
assert not any("postgres://" in line for path in DEPLOY.glob("*.toml") for line in path.read_text().splitlines() if not line.startswith("#")), "no URL in a manifest"
print("compose-check: opt-in Postgres service, migrate step order and roles passed")

# The proposal server (ADR 0022): opt in, its own pull and port, the read role, never a node's volume.
assert not any("proposals" in name for name in postgres), "the proposal server is opt-in"
proposals = json.loads(subprocess.check_output(
    ["docker", "compose", "--env-file", ".env.example", "-f", "compose.yaml", "-f", "compose.console.yaml",
     "-f", "compose.postgres.yaml", "-f", "compose.proposals.yaml", "--profile", "generations", "--profile", "console",
     "config", "--format", "json"], cwd=DEPLOY, text=True))["services"]
assert proposals["proposals"]["command"][:3] == ["workspaces", "mcp", "--listen"]
assert proposals["proposals"]["image"].endswith("-cloud")
assert proposals["proposals-pull"]["command"][:4] == ["snapshot", "pull", "--every", "30"]
for name in ["proposals-first-pull", "proposals-pull", "proposals"]:
    data = next(mount for mount in proposals[name]["volumes"] if mount["target"] == "/var/lib/meada/proposals")
    assert data["source"] == "proposals-data"
    assert all(mount.get("source") not in {"node-one", "node-two", "job-indexes", "console-data"} for mount in proposals[name]["volumes"])
    assert proposals[name]["environment"]["MEADA_POSTGRES_READ_URL"].startswith("postgres://meada_read:"), "the read role"
    assert "MEADA_POSTGRES_URL" not in proposals[name]["environment"]
assert proposals["proposals"]["depends_on"]["proposals-first-pull"]["condition"] == "service_completed_successfully"
assert proposals["proposals-first-pull"]["depends_on"]["postgres-migrate"]["condition"] == "service_completed_successfully"
assert proposals["proposals-proxy"]["ports"][0]["host_ip"] == "127.0.0.1" and proposals["proposals-proxy"]["ports"][0]["published"] == "8445"
assert all("ports" not in proposals[name] for name in ["proposals", "proposals-pull", "proposals-first-pull"])
assert "reverse_proxy proposals:8090" in (DEPLOY / "Caddyfile.proposals").read_text()
proposals_bootstrap = tomllib.loads((DEPLOY / "proposals.workspace.toml").read_text())
assert proposals_bootstrap["workspace"]["source"] == "store" and proposals_bootstrap["snapshot"]["node_name"] == "proposals"
assert proposals_bootstrap["postgres"]["url_env"] == "MEADA_POSTGRES_READ_URL"
assert proposals_bootstrap["snapshot"]["local_dir"] != console_bootstrap["snapshot"]["local_dir"]
for section in ["valkey", "generations", "refresh_lock"]:
    assert proposals_bootstrap[section] == node_bootstrap[section]
print("compose-check: opt-in proposal server, its pull, port and read role passed")

# The local accounts proof of concept (ADR 0024): one env file selects the whole recipe.
env = dict(line.split("=", 1) for line in (DEPLOY / ".env.accounts.example").read_text().splitlines()
           if line and not line.startswith("#"))
assert env["COMPOSE_FILE"].split(":") == ["compose.yaml", "compose.console.yaml", "compose.postgres.yaml", "compose.accounts.yaml"]
assert env["COMPOSE_PROFILES"].split(",") == ["generations", "console"]
poc = json.loads(subprocess.check_output(
    ["docker", "compose", "--env-file", ".env.accounts.example", "config", "--format", "json"],
    cwd=DEPLOY, text=True))["services"]


def reaches(services, start, goal, seen=()):
    """Whether `start` waits, directly or not, for `goal`."""
    return any(dep == goal or (dep not in seen and reaches(services, dep, goal, seen + (dep,)))
               for dep in services[start].get("depends_on", {}))


# The order: certificates, Postgres, migrate, store and Valkey, the seed, the job, the console and the nodes.
for later, earlier in [("postgres", "certificates"), ("postgres-migrate", "postgres"), ("seed", "bucket"), ("seed", "valkey"),
                       ("bucket", "store"), ("store", "certificates"), ("valkey", "certificates"),
                       ("generation-indexer", "seed"), ("generation-indexer", "postgres-migrate"),
                       ("console", "console-first-pull"), ("console", "postgres-migrate"), ("console", "certificates"),
                       ("console-first-pull", "generation-indexer"), ("generation-one", "first-pull-one"),
                       ("generation-two", "first-pull-two"), ("generation-one", "postgres-migrate"),
                       ("generation-one", "certificates"), ("generation-two", "certificates"),
                       ("first-pull-one", "generation-indexer"), ("first-pull-two", "generation-indexer")]:
    assert reaches(poc, later, earlier), f"{later} must wait for {earlier}"
assert poc["seed"]["depends_on"]["bucket"]["condition"] == "service_completed_successfully"
assert poc["generation-indexer"]["depends_on"]["seed"]["condition"] == "service_completed_successfully"

# The key pair: the private half in the console's and the certificates step's mounts, no other.
def volumes(name):
    return {mount["source"]: mount for mount in poc[name]["volumes"] if mount["type"] == "volume"}


assert [name for name in poc if "accounts-private" in volumes(name)] == ["certificates", "console"]
assert volumes("console")["accounts-private"]["read_only"]
for name in ["generation-one", "generation-two", "console"]:
    assert volumes(name)["accounts-public"]["read_only"], name
assert "accounts-public" not in volumes("generation-indexer")
script = (DEPLOY / "certificates.sh").read_text()
assert "openssl genpkey -algorithm ed25519 -out /accounts-private/private.pem" in script
assert not any(word in line for line in script.splitlines() if "accounts-private" in line for word in ["cat ", "echo ", "printf "]), "the key is never printed"

# The manifests: the console signs and keeps accounts, the nodes hold the public half only.
mounted = lambda name: {pathlib.Path(m["source"]).name for m in poc[name]["volumes"] if m["type"] == "bind"}
assert "console.accounts.workspace.toml" in mounted("console")
assert all("generations.accounts.workspace.toml" in mounted(name) for name in ["generation-one", "generation-two"])
poc_console = tomllib.loads((DEPLOY / "console.accounts.workspace.toml").read_text())
poc_node = tomllib.loads((DEPLOY / "generations.accounts.workspace.toml").read_text())
assert poc_console["ui"]["operations"] is True and "oidc" not in poc_console and "oidc" not in poc_node
assert poc_console["accounts"] == {"public_key_file": "/etc/meada/accounts/public.pem", "private_key_file": "/etc/meada/accounts-private/private.pem"}
assert poc_console["postgres"]["url_env"] == "MEADA_POSTGRES_URL"
assert poc_node["accounts"] == {"public_key_file": "/etc/meada/accounts/public.pem"}
assert poc_node["postgres"]["url_env"] == "MEADA_POSTGRES_READ_URL"
assert poc_node["ui"]["public_url"] == poc_console["ui"]["public_url"], "the nodes' issuer is the console's public_url"
for bootstrap in [poc_console, poc_node]:
    for section in ["valkey", "generations", "refresh_lock"]:
        assert bootstrap[section] == node_bootstrap[section]
    for key in ["endpoint", "region", "bucket", "prefix", "credentials", "ca_file"]:
        assert bootstrap["snapshot"][key] == node_bootstrap["snapshot"][key]
assert poc["console"]["environment"]["MEADA_POSTGRES_URL"].startswith("postgres://meada_write:")
assert "MEADA_ADMIN_PASSWORD" in poc["console"]["environment"]
assert all("MEADA_ADMIN_PASSWORD" not in poc[name]["environment"] for name in ["generation-one", "generation-two"])

# The proxy of the nodes forwards Authorization and holds no bearer; the other profiles' keep theirs.
caddyfile = (DEPLOY / "Caddyfile.accounts").read_text()
assert "MEADA_TOKEN" not in caddyfile and "header_up" not in caddyfile and "reverse_proxy backend-one:7333 backend-two:7333" in caddyfile
assert "environment" not in poc["proxy"] and "Caddyfile.accounts" in mounted("proxy")
for profile in [local, generations]:
    assert "MEADA_TOKEN" in profile["services"]["proxy"]["environment"]
    assert "Caddyfile" in {pathlib.Path(m["source"]).name for m in profile["services"]["proxy"]["volumes"] if m["type"] == "bind"}


def listen_port(services, alias):
    """The --listen port of the backend the proxy reaches as `alias`."""
    backend = next(s for s in services.values() if alias in ((s.get("networks") or {}).get("default") or {}).get("aliases", []))
    return backend["command"][backend["command"].index("--listen") + 1].rsplit(":", 1)[1]


# The main proxy, in every profile: loopback only, the exact token matcher, the upstream port the backends listen on.
main_caddyfile = (DEPLOY / "Caddyfile").read_text()
assert '@admitted header Authorization "Bearer {$MEADA_TOKEN}"' in main_caddyfile, "the exact token matcher"
for services in [local["services"], generations["services"], console, postgres, proposals, poc]:
    assert services["proxy"]["ports"][0]["host_ip"] == "127.0.0.1", "the proxy listens on loopback only"
    upstream = f"reverse_proxy backend-one:{listen_port(services, 'backend-one')} backend-two:{listen_port(services, 'backend-two')}"
    assert upstream in (caddyfile if services is poc else main_caddyfile), upstream
assert "accounts" not in "".join(console_bootstrap) and "accounts" not in "".join(node_bootstrap)
print("compose-check: local accounts profile, key pair, manifests, proxy and order passed")
