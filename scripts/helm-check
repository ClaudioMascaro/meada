steps = refresh[-1].split(" && ")
assert [step.split()[:3] for step in steps] == [["meada", "workspace", "pull"], ["/bin/sh", "/etc/meada/fetch.sh"],
    ["meada", "index", "--workspace"], ["meada", "snapshot", "publish"]]
# A store-sourced bootstrap lists no repository: without $1 the fetch reads the operator's list.
assert "[[repository]]" not in manifest(console_profile)
assert_fetch(console_profile)
claim = render("-f", str(CHART / "values-console.yaml"), "--set-json", "console.operatorGroups=[]",
               "--set", "console.operatorClaim=meada_operator", "--set", "console.operations=true", "--set", "tls.caConfigMap=private-ca")
