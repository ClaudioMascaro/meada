assert next(item for item in bundled if item["kind"] == "Job")["metadata"]["annotations"]["helm.sh/hook"] == "post-install,post-upgrade"
for profile in [default, generations, console_profile]:
    assert not any(item["kind"] in ("StatefulSet", "Job") for item in profile), "Postgres and its migrate step are opt-in"
    assert "postgres" not in yaml.dump(profile).lower(), "disabled by default, nothing of Postgres renders"
for arguments, problem in [
    (["-f", str(CHART / "values-console.yaml"), "--set", "modules.oidc.github.enabled=true"], "modules.oidc.github requires"),
