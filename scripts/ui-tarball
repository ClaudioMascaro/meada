#!/usr/bin/env python3
"""Package a cloud image's frontend under one versioned directory for a release."""

import argparse
import json
from pathlib import Path
import subprocess
import tarfile
import tempfile
import tomllib


parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("image")
parser.add_argument("output", type=Path)
args = parser.parse_args()
root = Path(__file__).resolve().parent.parent
version = tomllib.loads((root / "Cargo.toml").read_text())["workspace"]["package"]["version"]
directory = f"meada-ui-{version}"
args.output.mkdir(parents=True, exist_ok=True)
artifact = args.output / f"{directory}.tar.gz"

with tempfile.TemporaryDirectory(prefix="meada-ui-") as name:
    frontend = Path(name) / directory
    container = subprocess.check_output(["docker", "create", args.image], text=True).strip()
    try:
        subprocess.run(["docker", "cp", f"{container}:/usr/share/meada/ui", str(frontend)], check=True)
    finally:
        subprocess.run(["docker", "rm", container], check=True, stdout=subprocess.DEVNULL)
    assert (frontend / "index.html").is_file(), "frontend index.html is required"
    assert json.loads((frontend / "meada-ui.json").read_text()) == {"version": version}, \
        "frontend version must match the workspace version"
    with tarfile.open(artifact, "w:gz") as archive:
        archive.add(frontend, arcname=directory)

print(artifact)
