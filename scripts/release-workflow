#!/usr/bin/env python3
"""Regenerate or check the complete release workflow with Meada's draft-release policy."""

import argparse
import difflib
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tempfile


VERSION = "0.32.0"
CONFIG = Path("dist-workspace.toml")
WORKFLOW = Path(".github/workflows/release.yml")
HEADER = b"# This file was autogenerated by dist: https://axodotdev.github.io/cargo-dist\n"
PLAN = b"      - id: plan\n        run: |\n"
CREATE = (
    b'          gh release create "${{ needs.plan.outputs.tag }}" --target "$RELEASE_COMMIT" '
    b'$PRERELEASE_FLAG --title "$ANNOUNCEMENT_TITLE" --notes-file "$RUNNER_TEMP/notes.txt" artifacts/*\n'
)


def once(source, before, after, name):
    if source.count(before) != 1:
        raise ValueError(f"expected exactly one {name}; review the pinned release policy")
    return source.replace(before, after, 1)


def policy(source):
    if source.count(b"gh release create ") != 1 or b"--draft" in source:
        raise ValueError("expected one unmodified release creation command")
    source = once(source, HEADER, HEADER + b"# Meada draft policy: python3 scripts/release-workflow --write\n", "generated header")
    source = once(source, PLAN, PLAN + b"          python3 scripts/release-workflow --check\n", "plan block")
    return once(source, CREATE, CREATE.replace(b"gh release create ", b"gh release create --draft ", 1), "release command")


def generation_config(source):
    sections = re.findall(rb"(?ms)^\[dist\]\n(.*?)(?=^\[|\Z)", source)
    if len(sections) != 1:
        raise ValueError("expected one [dist] section")
    section = sections[0]
    versions = re.findall(rb'(?m)^cargo-dist-version = "([^"]+)"$', section)
    if versions != [VERSION.encode()]:
        raise ValueError(f"release policy requires cargo-dist-version = {VERSION!r}")
    dirty = b'allow-dirty = ["ci"]'
    if re.findall(rb"(?m)^allow-dirty = .*", section) != [dirty]:
        raise ValueError('release policy requires exactly allow-dirty = ["ci"]')
    changed = once(source, dirty, b"allow-dirty = []", "CI check exemption")
    if once(changed, b"allow-dirty = []", dirty, "temporary CI check exemption") != source:
        raise ValueError("temporary configuration changed outside the CI exemption")
    return changed


def run(args, root, **kwargs):
    return subprocess.run(args, cwd=root, check=True, **kwargs)


def render(root):
    config = generation_config((root / CONFIG).read_bytes())
    dist = shutil.which("dist")
    if not dist:
        raise ValueError(f"put the installed cargo-dist {VERSION} on PATH")
    version = run([dist, "--version"], root, stdout=subprocess.PIPE, text=True).stdout.strip()
    if version != f"cargo-dist {VERSION}":
        raise ValueError(f"expected cargo-dist {VERSION}, got {version!r}")
    head = run(["git", "rev-parse", "HEAD"], root, stdout=subprocess.PIPE, text=True).stdout.strip()
    patch = run(["git", "diff", "--binary", "HEAD", "--"], root, stdout=subprocess.PIPE).stdout
    with tempfile.TemporaryDirectory(prefix="meada-release-") as name:
        tree = Path(name) / "tree"
        run(["git", "clone", "--local", "--no-hardlinks", "--quiet", "--no-checkout", str(root), str(tree)], root)
        run(["git", "checkout", "--detach", "--quiet", head], tree)
        cloned_head = run(["git", "rev-parse", "HEAD"], tree, stdout=subprocess.PIPE, text=True).stdout.strip()
        if cloned_head != head:
            raise ValueError("temporary clone HEAD differs from the source checkout")
        run(["git", "remote", "set-url", "origin", "https://github.com/ClaudioMascaro/meada"], tree)
        if patch:
            run(["git", "apply", "--binary"], tree, input=patch)
        (tree / CONFIG).write_bytes(config)
        env = dict(os.environ, CARGO_TARGET_DIR=str(Path(name) / "target"))
        run([dist, "generate", "--mode", "ci"], tree, env=env)
        return policy((tree / WORKFLOW).read_bytes())


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    mode = parser.add_mutually_exclusive_group(required=True)
    mode.add_argument("--write", action="store_true", help="regenerate the workflow; stage new generation inputs first")
    mode.add_argument("--check", action="store_true", help="compare all generated and policy bytes without writing the checkout")
    args = parser.parse_args()
    root = Path(__file__).resolve().parent.parent
    path = root / WORKFLOW
    expected = render(root)
    if args.write:
        with tempfile.NamedTemporaryFile(dir=path.parent, delete=False) as output:
            temporary = Path(output.name)
            output.write(expected)
        try:
            temporary.chmod(path.stat().st_mode & 0o777)
            temporary.replace(path)
        finally:
            temporary.unlink(missing_ok=True)
    elif expected != path.read_bytes():
        sys.stderr.writelines(difflib.unified_diff(
            path.read_text().splitlines(keepends=True), expected.decode().splitlines(keepends=True),
            fromfile=str(WORKFLOW), tofile="regenerated draft policy",
        ))
        raise ValueError("release workflow differs; run python3 scripts/release-workflow --write")
    print(f"{WORKFLOW}: {'written' if args.write else 'matches complete generated draft policy'}")


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError, subprocess.CalledProcessError) as error:
        sys.exit(f"release-workflow: {error}")
